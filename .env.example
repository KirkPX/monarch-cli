# Copy to .env for local dev, or export these in CI/automation.
# Precedence: command flags > these env vars > settings file / keychain > defaults.

# Monarch token. Interactively, prefer `monarch login` (stored in the OS keychain).
# In CI and for agents, set this instead. The keychain is usually unavailable there.
MONARCH_API_KEY=

# Sign-in with nobody at the keyboard. `monarch login` reads these when set.
# Prefer --password-stdin to MONARCH_PASSWORD where you can: another program on the
# machine may be able to read a process's environment.
# MONARCH_EMAIL=you@example.com
# MONARCH_PASSWORD=

# Override the API base URL (defaults to https://api.monarch.com).
# MONARCH_BASE_URL=https://api.monarch.com

# Named account (defaults to "default").
# MONARCH_ACCOUNT=default

# Refuse every command that would change remote data. The safe choice for agents
# and automation. Set to 0 to let one run write when the settings file says
# "readOnly": true.
# MONARCH_READ_ONLY=1

# Use this settings file instead of the default one (`monarch config path`).
# MONARCH_CLI_CONFIG_FILE=./monarch-config.json

# The settings folder follows the platform: XDG_CONFIG_HOME where it is set, and
# APPDATA on Windows.

# Pick the credential store instead of keychain-then-file. "memory" keeps the key
# for one process only, and tests set it so they can never touch real credentials.
# "file" always uses the private credentials file.
# MONARCH_CLI_CREDENTIAL_STORE=memory

# Where the key is kept when the OS keychain is closed (as over SSH on macOS).
# MONARCH_CLI_CREDENTIALS_FILE=./credentials.json

# Promise that nothing opens a browser. monarch signs in at the terminal and opens
# none today; the test suite sets this so a future change cannot open one in a test.
# MONARCH_CLI_NO_BROWSER=1
